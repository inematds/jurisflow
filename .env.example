# JurisFlow — variáveis de ambiente (copie para .env e preencha)

# Banco MySQL (Drizzle ORM)
DATABASE_URL=mysql://usuario:senha@localhost:3306/jurisflow

# Servidor
PORT=3000
NODE_ENV=development

# Autenticação (JWT + OAuth)
JWT_SECRET=troque-por-um-segredo-aleatorio-longo
OAUTH_SERVER_URL=
OWNER_OPEN_ID=

# LLM usado pelo Assistente Jurídico IA
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Frontend
VITE_APP_ID=
VITE_FRONTEND_FORGE_API_KEY=
